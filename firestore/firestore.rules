rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isTeacher());

      // Bản chẩn đoán: giáo viên được cập nhật document người dùng.
      // Chưa kiểm tra danh sách field để loại trừ hoàn toàn lỗi từ validTeacherUpdate().
      allow update: if isTeacher();

      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /progress/{progressId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isTeacher());
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /emailReports/{reportId} {
      allow read, write: if false;
    }
  }
}
